generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ATTORNEY
  PARALEGAL
  STAFF
}

enum MatterStatus {
  OPEN
  PENDING
  CLOSED
  ARCHIVED
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum InteractionType {
  RESEARCH
  SUMMARIZE
  DRAFT
  EXTRACT
}

enum ReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model Firm {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  matters   Matter[]
  auditLogs AuditLog[]
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String
  role      Role     @default(ATTORNEY)
  firmId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm              Firm            @relation(fields: [firmId], references: [id])
  matters           Matter[]        @relation("MatterMembers")
  aiInteractions    AIInteraction[]
  auditLogs         AuditLog[]
  uploadedDocuments Document[]      @relation("DocumentUploader")

  @@index([firmId])
}

model Matter {
  id           String       @id @default(cuid())
  firmId       String
  title        String
  clientName   String
  practiceArea String
  status       MatterStatus @default(OPEN)
  description  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  firm           Firm            @relation(fields: [firmId], references: [id])
  members        User[]          @relation("MatterMembers")
  documents      Document[]
  aiInteractions AIInteraction[]
  auditLogs      AuditLog[]

  @@index([firmId])
}

model Document {
  id          String         @id @default(cuid())
  matterId    String
  title       String
  fileName    String
  storagePath String
  mimeType    String
  sizeBytes   Int
  status      DocumentStatus @default(UPLOADED)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Nullable: rows created before this column existed have no uploader, and
  // the backfill can only recover one where a DOCUMENT_UPLOADED audit entry
  // survives. Treat null as "unknown", never as "nobody".
  uploadedById String?

  matter     Matter          @relation(fields: [matterId], references: [id])
  uploadedBy User?           @relation("DocumentUploader", fields: [uploadedById], references: [id])
  chunks     DocumentChunk[]

  @@index([matterId])
  @@index([uploadedById])
  // Supports the global documents list, which orders by recency across every
  // project in a workspace.
  @@index([createdAt])
}

model DocumentChunk {
  id         String                      @id @default(cuid())
  documentId String
  chunkIndex Int
  content    String
  pageNumber Int?
  // Dimension left unspecified so the embedding provider can change without a
  // migration; all chunks must still use one provider at a time for retrieval.
  embedding  Unsupported("vector")?
  createdAt  DateTime                    @default(now())

  document  Document   @relation(fields: [documentId], references: [id])
  citations Citation[]

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model AIInteraction {
  id           String          @id @default(cuid())
  matterId     String
  userId       String
  type         InteractionType
  prompt       String
  response     String
  model        String
  reviewStatus ReviewStatus    @default(PENDING_REVIEW)
  reviewedAt   DateTime?
  createdAt    DateTime        @default(now())

  matter    Matter     @relation(fields: [matterId], references: [id])
  user      User       @relation(fields: [userId], references: [id])
  citations Citation[]

  @@index([matterId])
  @@index([userId])
}

model Citation {
  id              String  @id @default(cuid())
  aiInteractionId String
  chunkId         String
  quotedText      String
  claimText       String
  verified        Boolean @default(false)

  aiInteraction AIInteraction @relation(fields: [aiInteractionId], references: [id])
  chunk         DocumentChunk @relation(fields: [chunkId], references: [id])

  @@index([aiInteractionId])
  @@index([chunkId])
}

model AuditLog {
  id         String   @id @default(cuid())
  firmId     String
  userId     String?
  matterId   String?
  action     String
  entityType String
  entityId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  firm   Firm    @relation(fields: [firmId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])
  matter Matter? @relation(fields: [matterId], references: [id])

  @@index([firmId, createdAt])
  @@index([matterId])
}
