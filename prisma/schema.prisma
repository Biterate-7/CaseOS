generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  ATTORNEY
  PARALEGAL
  STAFF
}

enum MatterStatus {
  OPEN
  PENDING
  CLOSED
  ARCHIVED
}

enum DocumentStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

enum InteractionType {
  RESEARCH
  SUMMARIZE
  DRAFT
  EXTRACT
}

enum ReviewStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// Which knowledge the model was allowed to draw on for an interaction.
/// DOCUMENT_ONLY answers use retrieved chunks exclusively; DOCUMENT_PLUS_AI
/// additionally allows a clearly-labelled, citation-free "Additional Context"
/// section from the model's own knowledge; DOCUMENT_PLUS_EXTERNAL allows a
/// clearly-labelled "External Research" section whose every claim carries a
/// server-verified external citation (see ExternalCitation). Defaulted so
/// every pre-existing row is (accurately) recorded as document-only.
enum KnowledgeMode {
  DOCUMENT_ONLY
  DOCUMENT_PLUS_AI
  DOCUMENT_PLUS_EXTERNAL
}

/// Per-project permission. Distinct from `Role`, which is workspace-wide:
/// a workspace ADMIN may still be only a VIEWER on someone else's project.
enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum NotificationType {
  PROJECT_SHARED
  PROJECT_ROLE_CHANGED
  WORKSPACE_ROLE_CHANGED
  PROJECT_ACCESS_REMOVED
  INVITATION_ACCEPTED
  DOCUMENT_UPLOADED
  REVIEW_COMPLETED
  THREAD_REPLY
  THREAD_MENTION
  THREAD_RESOLVED
}

model Firm {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  matters       Matter[]
  auditLogs     AuditLog[]
  invitations   Invitation[]
  notifications Notification[]
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String
  role      Role     @default(ATTORNEY)
  firmId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  firm              Firm            @relation(fields: [firmId], references: [id])
  memberships       MatterMember[]
  aiInteractions    AIInteraction[]
  auditLogs         AuditLog[]
  uploadedDocuments Document[]      @relation("DocumentUploader")

  invitationsSent     Invitation[]   @relation("InvitationInviter")
  invitationsAccepted Invitation[]   @relation("InvitationAcceptor")
  notifications       Notification[] @relation("NotificationRecipient")
  notificationsCaused Notification[] @relation("NotificationActor")

  @@index([firmId])
}

model Matter {
  id           String       @id @default(cuid())
  firmId       String
  title        String
  clientName   String
  practiceArea String
  status       MatterStatus @default(OPEN)
  description  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  firm           Firm            @relation(fields: [firmId], references: [id])
  members        MatterMember[]
  documents      Document[]
  aiInteractions AIInteraction[]
  auditLogs      AuditLog[]
  notifications  Notification[]

  @@index([firmId])
}

/// Explicit join between Matter and User so membership can carry a role.
///
/// This replaced an implicit many-to-many (`@relation("MatterMembers")`),
/// which Prisma backs with a hidden two-column table that has nowhere to put
/// one. Existing rows were migrated across as OWNER, since the only way to
/// become a member before this existed was to create the project.
model MatterMember {
  id        String      @id @default(cuid())
  matterId  String
  userId    String
  role      ProjectRole @default(VIEWER)
  /// Null for memberships that predate this table.
  addedById String?
  createdAt DateTime    @default(now())

  matter Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matterId, userId])
  @@index([userId])
  @@index([matterId])
}

/// Pending invitation to join a workspace.
///
/// Needed because onboarding creates a new Firm for every signup, so without
/// this there is no way for two people to end up in the same workspace and
/// nothing to share a project with.
model Invitation {
  id     String           @id @default(cuid())
  firmId String
  email  String
  /// Workspace-wide role granted on acceptance.
  role   Role             @default(ATTORNEY)
  /// Unguessable; the accept link is the only proof of invitation.
  token  String           @unique
  status InvitationStatus @default(PENDING)

  invitedById  String
  acceptedById String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())

  firm       Firm  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  invitedBy  User  @relation("InvitationInviter", fields: [invitedById], references: [id])
  acceptedBy User? @relation("InvitationAcceptor", fields: [acceptedById], references: [id])

  @@index([firmId, status])
  @@index([email, status])
}

/// In-app notification. Delivery is pull-based: the bell polls and every
/// navigation refreshes it. No transport dependency, and adding email or a
/// websocket later needs no change to this shape.
model Notification {
  id     String           @id @default(cuid())
  /// Recipient.
  userId String
  firmId String
  type   NotificationType

  title String
  body  String?
  /// Where clicking it should land, e.g. /matters/:id?tab=review
  href  String?

  /// Who caused it. Null for system-generated entries.
  actorId  String?
  matterId String?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  user     User    @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor    User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  firm     Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  matter   Matter? @relation(fields: [matterId], references: [id], onDelete: Cascade)

  /// Drives the unread badge and the newest-first list in one index each.
  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model Document {
  id          String         @id @default(cuid())
  matterId    String
  title       String
  fileName    String
  storagePath String
  mimeType    String
  sizeBytes   Int
  status      DocumentStatus @default(UPLOADED)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Nullable: rows created before this column existed have no uploader, and
  // the backfill can only recover one where a DOCUMENT_UPLOADED audit entry
  // survives. Treat null as "unknown", never as "nobody".
  uploadedById String?

  matter     Matter          @relation(fields: [matterId], references: [id])
  uploadedBy User?           @relation("DocumentUploader", fields: [uploadedById], references: [id])
  chunks     DocumentChunk[]

  @@index([matterId])
  @@index([uploadedById])
  // Supports the global documents list, which orders by recency across every
  // project in a workspace.
  @@index([createdAt])
}

model DocumentChunk {
  id         String                      @id @default(cuid())
  documentId String
  chunkIndex Int
  content    String
  pageNumber Int?
  // Dimension left unspecified so the embedding provider can change without a
  // migration; all chunks must still use one provider at a time for retrieval.
  embedding  Unsupported("vector")?
  /// Generated column: to_tsvector('english', content), maintained by
  /// Postgres so it can never drift from `content`. Backed by a GIN index.
  /// Unsupported so Prisma never tries to write it — generated columns
  /// reject writes.
  contentTsv Unsupported("tsvector")?
  createdAt  DateTime                    @default(now())

  document  Document   @relation(fields: [documentId], references: [id])
  citations Citation[]

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}

model AIInteraction {
  id            String          @id @default(cuid())
  matterId      String
  userId        String
  type          InteractionType
  prompt        String
  response      String
  model         String
  knowledgeMode KnowledgeMode   @default(DOCUMENT_ONLY)
  reviewStatus  ReviewStatus    @default(PENDING_REVIEW)
  reviewedAt    DateTime?
  createdAt     DateTime        @default(now())

  matter            Matter             @relation(fields: [matterId], references: [id])
  user              User               @relation(fields: [userId], references: [id])
  citations         Citation[]
  externalCitations ExternalCitation[]

  @@index([matterId])
  @@index([userId])
}

/// One verified external source cited by an [En] marker in an interaction's
/// "External Research" section (DOCUMENT_PLUS_EXTERNAL mode). Rows exist only
/// for citations that survived server-side verification — the URL was fetched
/// and the domain passed the source-quality policy. Unverifiable candidates
/// are removed from the answer before persistence and recorded only in the
/// audit detail.
model ExternalCitation {
  id              String   @id @default(cuid())
  aiInteractionId String
  /// The n in [En], as emitted by the model. Survivors keep their original
  /// numbers, so gaps mean a sibling citation failed verification.
  marker          Int
  title           String
  publisher       String
  /// Publication date as printed by the source; free text because real
  /// citations carry everything from "2024-05-01" to "Spring 2019".
  publishedAt     String?
  url             String
  /// Where the URL actually resolved after redirects, when different.
  finalUrl        String?
  domain          String
  /// Source-quality tier at verification time: preferred | acceptable | unknown.
  tier            String
  httpStatus      Int?
  /// When the server verified the URL — the access date shown when the
  /// source carries no publication date.
  accessedAt      DateTime @default(now())

  aiInteraction AIInteraction @relation(fields: [aiInteractionId], references: [id])

  @@index([aiInteractionId])
}

/// Verification cache for external URLs. A URL verified recently is not
/// re-fetched on every question that cites it (TTL enforced in code).
model ExternalSourceCache {
  id         String   @id @default(cuid())
  url        String   @unique
  finalUrl   String?
  httpStatus Int?
  ok         Boolean
  checkedAt  DateTime @default(now())
}

model Citation {
  id              String  @id @default(cuid())
  aiInteractionId String
  chunkId         String
  quotedText      String
  claimText       String
  verified        Boolean @default(false)

  aiInteraction AIInteraction @relation(fields: [aiInteractionId], references: [id])
  chunk         DocumentChunk @relation(fields: [chunkId], references: [id])

  @@index([aiInteractionId])
  @@index([chunkId])
}

model AuditLog {
  id         String   @id @default(cuid())
  firmId     String
  userId     String?
  matterId   String?
  action     String
  entityType String
  entityId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  firm   Firm    @relation(fields: [firmId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])
  matter Matter? @relation(fields: [matterId], references: [id])

  @@index([firmId, createdAt])
  @@index([matterId])
}
