# Database (PostgreSQL on Supabase)
# DATABASE_URL: "Transaction pooler" connection string (runtime queries)
# DIRECT_URL:   "Direct connection" string (migrations only)
DATABASE_URL="postgresql://user:password@localhost:5432/caseos"
DIRECT_URL="postgresql://user:password@localhost:5432/caseos"

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Supabase (document storage)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="documents"

# AI generation provider — selects which provider lib/ai/provider.ts uses.
# One of: gemini | grok | openai. Only the selected provider's key is required.
AI_PROVIDER="gemini"

# Gemini (Google Gen AI) — current default generation provider
GEMINI_API_KEY=""
GEMINI_CHAT_MODEL="gemini-flash-latest"

# xAI Grok — OpenAI-compatible API (set AI_PROVIDER=grok to use)
XAI_API_KEY=""
XAI_CHAT_MODEL="grok-4-fast"

# OpenAI — chat generation only (set AI_PROVIDER=openai to use)
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"

# Embeddings run through the Gemini API and reuse GEMINI_API_KEY above.
# (They used to run locally via transformers.js, but onnxruntime-node is far
# too large for a serverless function and needs a writable model cache.)
# Changing either value invalidates every stored vector — pgvector cannot
# compare different widths. Run `npm run db:reset-embeddings` afterwards.
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSIONS="768"
