# =============================================================================
# CaseOS environment template.  Copy to .env and fill in.  .env is gitignored.
#
# Variable NAMES are identical in every environment; only the values differ,
# and each environment supplies its own.  There is deliberately no
# DATABASE_URL_DEV / DATABASE_URL_PROD split — that would mean application
# code choosing between them at runtime, which is how a process ends up
# writing to the wrong database.  The app only ever knows DATABASE_URL.
#
# Local .env            -> the caseos-dev Supabase project
# Vercel "Preview"      -> caseos-dev (or a dedicated preview project)
# Vercel "Production"   -> the production Supabase project
#
# See docs/environments.md for setup and the migration workflow.
# =============================================================================

# Database (PostgreSQL on Supabase)
# DATABASE_URL: "Transaction pooler" string, port 6543 — runtime queries
# DIRECT_URL:   "Session pooler"     string, port 5432 — migrations only
#
# Use the SESSION POOLER for DIRECT_URL, not db.<ref>.supabase.co — that host
# is IPv6-only and unreachable from this network.
#
# WARNING: `npm run db:migrate` applies immediately to whatever this points
# at.  Run `npm run doctor` and confirm the host is your DEV project ref
# before migrating.  Pointing this at production has already caused one
# outage (see docs/environments.md).
DATABASE_URL="postgresql://postgres.<dev-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<dev-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Clerk authentication
# Use DEVELOPMENT keys (pk_test_/sk_test_) locally and in Preview; production
# keys (pk_live_/sk_live_) only in Vercel Production.  Live keys additionally
# require the deployment domain to be registered on the Clerk instance, which
# is why a live key on a *.vercel.app preview URL fails.
# Both keys must come from the SAME Clerk instance — mixing a test
# publishable key with a live secret key fails at middleware.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"

# Supabase (document storage)
# Must belong to the SAME Supabase project as DATABASE_URL above — a dev
# database paired with the production bucket writes test files into
# production storage.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="documents"

# AI generation provider — selects which provider lib/ai/provider.ts uses.
# One of: gemini | grok | openai. Only the selected provider's key is required.
AI_PROVIDER="gemini"

# Gemini (Google Gen AI) — current default generation provider
GEMINI_API_KEY=""
GEMINI_CHAT_MODEL="gemini-flash-latest"

# xAI Grok — OpenAI-compatible API (set AI_PROVIDER=grok to use)
XAI_API_KEY=""
XAI_CHAT_MODEL="grok-4-fast"

# OpenAI — chat generation only (set AI_PROVIDER=openai to use)
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"

# Embeddings run through the Gemini API and reuse GEMINI_API_KEY above.
# (They used to run locally via transformers.js, but onnxruntime-node is far
# too large for a serverless function and needs a writable model cache.)
# Changing either value invalidates every stored vector — pgvector cannot
# compare different widths. Run `npm run db:reset-embeddings` afterwards.
EMBEDDING_MODEL="gemini-embedding-001"
EMBEDDING_DIMENSIONS="768"

# Cron authentication. Vercel Cron sends `Authorization: Bearer $CRON_SECRET`
# to /api/cron/*. Set this to a long random string in Vercel (Production).
# If unset, the reconcile cron refuses to run (fails closed). The per-request
# lazy reconciliation in the loaders does not depend on it.
CRON_SECRET=""
