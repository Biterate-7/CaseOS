# Database (PostgreSQL on Supabase)
# DATABASE_URL: "Transaction pooler" connection string (runtime queries)
# DIRECT_URL:   "Direct connection" string (migrations only)
DATABASE_URL="postgresql://user:password@localhost:5432/caseos"
DIRECT_URL="postgresql://user:password@localhost:5432/caseos"

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Supabase (document storage)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="documents"

# AI generation (xAI Grok — OpenAI-compatible API, used in Phase 3)
XAI_API_KEY=""
XAI_CHAT_MODEL="grok-4-fast"

# Embeddings run locally via transformers.js (no API key needed).
# Override the model if desired; changing it requires re-ingesting documents.
EMBEDDING_MODEL="Xenova/bge-small-en-v1.5"
